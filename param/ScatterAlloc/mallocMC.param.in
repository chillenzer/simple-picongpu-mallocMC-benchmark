/** @file
 *
 * Assembly template of the ScatterAlloc benchmark allocator; rendered by
 * `python3 config.py render-param ScatterAlloc <config-name>` from the
 * `heap` and `hash` objects of the selected config.json config into
 * build/<commit>/FoilLCT/ScatterAlloc/<name>/include/picongpu/
 * param/mallocMC.param.
 */

#pragma once

#include <pmacc/alpakaHelper/acc.hpp>

#include <mallocMC/creationPolicies/Scatter.hpp>
#include <mallocMC/mallocMC.hpp>

#include "profiles/ScatterHeapConfig.hpp"
#include "profiles/{hashProfile}.hpp"

// heap-args: pageSize accessBlockSize regionSize wasteFactor resetFreedPages

namespace picongpu
{
    using DeviceHeap = mallocMC::Allocator<
        alpaka::AccToTag<pmacc::Acc<DIM1>>,
        mallocMC::CreationPolicies::Scatter<
            ScatterHeapConfig<{heapArgs}>,
            {hashProfile}<ScatterHeapConfig<{heapArgs}>>>,
        mallocMC::DistributionPolicies::Noop, mallocMC::OOMPolicies::ReturnNull,
        mallocMC::ReservePoolPolicies::AlpakaBuf<pmacc::Acc<DIM1>>,
        mallocMC::AlignmentPolicies::Shrink<>>;

} // namespace picongpu
