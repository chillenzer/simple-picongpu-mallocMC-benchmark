/** @file
 *
 * Fine-tuning of the particle heap for GPUs: When running on GPUs, we use a
 * high-performance parallel "new" allocator (mallocMC) which can be
 * parametrized here.
 */

#pragma once

#include <pmacc/alpakaHelper/acc.hpp>

#include <mallocMC/creationPolicies/FlatterScatter.hpp>
#include <mallocMC/mallocMC.hpp>

namespace picongpu {
/** Define a new allocator
 *
 * FlatterScatter; the malloc and free delays (in nanoseconds) are injected
 * into every allocation and free request and read at run time from the
 * MALLOCMC_MALLOC_DELAY / MALLOCMC_FREE_DELAY environment variables
 * (run_all.sh sets them for each run).
 */
using DeviceHeap = mallocMC::Allocator<
    alpaka::AccToTag<pmacc::Acc<DIM1>>,
    mallocMC::CreationPolicies::FlatterScatter<
        mallocMC::CreationPolicies::FlatterScatterAlloc::DefaultHeapConfig<
            128U * 1024U * 1024U,  // accessblocksize
            128U * 1024U,          // pagesize
            2U>>,                 // wastefactor
    mallocMC::DistributionPolicies::Noop, mallocMC::OOMPolicies::ReturnNull,
    mallocMC::ReservePoolPolicies::AlpakaBuf<pmacc::Acc<DIM1>>,
    mallocMC::AlignmentPolicies::Shrink<>>;

} // namespace picongpu
